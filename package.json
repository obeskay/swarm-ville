{
  "name": "swarm-ville",
  "version": "3.0.0",
  "description": "A small town you can watch your agents work in — agentic loop orchestration with live observability and a proximity video room.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --names \"relay,web\" -c \"yellow,cyan\" \"npm:dev:relay\" \"npm:dev:web\"",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:relay": "node --watch server/index.js --port 8765",
    "relay": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "art": "node tools/genart.mjs && python3 tools/pixelize.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
