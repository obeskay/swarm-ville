{
  "name": "swarm-ville-mini",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ws": "node server/ws-server.js",
    "server": "node server/ws-server.js",
    "generate-sprites": "node scripts/generate_sprites.js",
    "build": "node scripts/generate_sprites.js && tsc && vite build",
    "preview": "vite preview",
    "dev:all": "concurrently --names \"WS,VITE\" -c \"cyan,magenta\" \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "lucide-react": "^1.28.0",
    "pixi.js": "^8.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
