{
  "name": "swarm-ville",
  "version": "3.0.0",
  "description": "A shared office where you leave an agent working: drag it onto the floor, back other people's ideas, talk face to face.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --names \"relay,web\" -c \"yellow,cyan\" \"npm:dev:relay\" \"npm:dev:web\"",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:relay": "node --watch server/index.js --port 8765",
    "relay": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"server/**/*.test.js\"",
    "art": "node tools/genart.mjs && python3 tools/pixelize.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
