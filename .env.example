# Copy to .env and edit. .env is git-ignored; never commit real keys.
# The relay reads these — none of them are exposed to the browser.

# --- relay ------------------------------------------------------------------
# Prefer the --port flag (npm run dev already passes it). PORT is honoured last
# so PaaS deployments keep working.
# RELAY_PORT=8765
# HOST=127.0.0.1

# Comma-separated browser origins allowed to reach the API and the WebSocket.
# Anything not listed is rejected with 403. Set this before exposing the relay.
# ALLOWED_ORIGINS=https://swarmville.example.com

# --- model provider ---------------------------------------------------------
# agy | agy-pro | crosstalk | claude | ollama | anthropic | mock (unset = agy)
PROVIDER=mock

# Anthropic: the key stays server-side and is never sent to the client.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Ollama: fully local, no key needed.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# --- limits -----------------------------------------------------------------
# MAX_GOAL_CHARS=600
# RATE_LIMIT_RPM=60
# WS_RATE_LIMIT=240
# MAX_CONNECTIONS=64
# MAX_REVISIONS=2
# ROOM_CAPACITY=8
# The shared line of ideas: how many at once, and how many one person may have.
# QUEUE_MAX=12
# JOBS_PER_PEER=2

# --- optional TURN for the video room ---------------------------------------
# Only needed when peers sit behind symmetric NATs. These are baked into the
# client bundle, so use short-lived credentials from your TURN provider.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USER=
# VITE_TURN_CREDENTIAL=

# Where the archivist keeps one line per finished run.
ARCHIVE_FILE=.data/archive.jsonl

# Where a published single-file release is written, and its size ceiling.
RELEASE_DIR=.data/releases
MAX_RELEASE_BYTES=524288

# Off by default. On, the builder takes the plan one numbered step at a time,
# which costs one model call per step instead of one for the whole plan.
DECOMPOSE=0
MAX_TASKS=5

# --- serving the app from the relay (one process, see DEPLOY.md) --------------
# `npm run build && npm start` serves the built app and the API on one port.
# Folder holding the built app (its index.html). Unset = dist.
# STATIC_DIR=dist

# A shared code for the whole deployment. Set, every API call and the WebSocket
# need it and the app shows a lock screen first. Set this before HOST=0.0.0.0
# or any public address, or anyone who can reach it can spend your model budget.
# Invite link: https://your.domain/?code=SECRET
# ACCESS_CODE=change-me

# The relay's own address is always an allowed origin, so ALLOWED_ORIGINS above
# is only for a page served from somewhere else (for example a dev server).
# One exception: a relay on 127.0.0.1 with no ACCESS_CODE and no TRUST_PROXY only
# accepts localhost names as its own address (protects against DNS rebinding).

# Behind a reverse proxy (Caddy, nginx, a PaaS): read the visitor's address from
# X-Forwarded-For so rate limits are per person, not per proxy. Only turn this on
# when the relay cannot be reached except through that proxy.
# TRUST_PROXY=1

# 127.0.0.1 keeps the relay private to this machine. Docker sets 0.0.0.0.
# HOST=127.0.0.1
